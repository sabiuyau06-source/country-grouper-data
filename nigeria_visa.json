 "changes": [
  {
   "id": "2025-01-kenya",
   "date": "2025-01-22",
   "country": "Kenya",
   "type": "status-change",
   "from": "e-visa / eTA",
   "to": "visa-free",
   "title": "Kenya: no more visa or eTA for Nigerians",
   "details": "Kenya removed the Electronic Travel Authorisation (eTA) requirement for most African countries, including Nigeria. Nigerians can now visit Kenya visa-free for up to 60 days (exceptions: Somalia and Libya nationals).",
   "source": "https://allafrica.com/stories/202501220142.html",
   "source_name": "AllAfrica"
  },
  {
   "id": "2025-07-usa",
   "date": "2025-07-08",
   "country": "United States",
   "type": "info",
   "from": "visa required",
   "to": "visa required",
   "title": "USA: Nigerian visitor visas now single-entry, 3 months",
   "details": "The United States revised its visa reciprocity for Nigerians: most non-immigrant visas (e.g. B1/B2 visitor) are now single-entry and valid for 3 months. A visa is still required.",
   "source": "https://allafrica.com/stories/202507090027.html",
   "source_name": "AllAfrica"
  },
  {
   "id": "2026-02-angola",
   "date": "2026-02-15",
   "country": "Angola",
   "type": "agreement",
   "from": "e-visa",
   "to": "e-visa",
   "title": "Nigeria and Angola sign visa waiver agreement (diplomatic & official passports)",
   "details": "Nigeria and Angola signed a bilateral agreement waiving visa requirements for holders of diplomatic and official passports, on the margins of the 39th African Union Summit. Ordinary (green) passport holders still need an e-visa for Angola.",
   "source": "https://foreignaffairs.gov.ng/news/nigeria-and-angola-signs-agreement-to-ease-the-movement-of-diplomats-and-government-officials/",
   "source_name": "Nigeria Ministry of Foreign Affairs"
  },
  {
   "id": "2026-07-congo",
   "date": "2026-07-15",
   "country": "Republic of the Congo",
   "type": "upcoming",
   "from": "visa required",
   "to": "visa-free (from 1 Jan 2027)",
   "title": "Republic of the Congo to drop visas for Nigerians from 1 January 2027",
   "details": "Congo-Brazzaville announced visa-free entry for all African nationals, including Nigerians, starting 1 January 2027, subject to minimal administrative and security conditions. Until then a visa is still required.",
   "source": "https://www.legit.ng/nigeria/1724660-two-countries-grant-visa-free-entry-nigerians/",
   "source_name": "Legit.ng"
  },
  {
   "id": "2026-09-25-tanzania",
   "date": "2026-09-25",
   "country": "Tanzania",
   "type": "info",
   "from": "visa required (referred visa – prior clearance needed)",
   "to": "visa required (standard application)",
   "title": "Tanzania: Nigerians no longer need special 'referred visa' clearance",
   "details": "Tanzania Immigration Services removed Nigerian nationals from its 'referred visa' category with immediate effect, following amendments in Government Gazette No. 246 of 2026. Holders of ordinary Nigerian passports no longer need special clearance from Tanzanian immigration (which could take up to about two months) before a visa is issued. A visa is still required, applied for through the standard online portal or at designated entry points.",
   "source": "https://www.thecable.ng/tanzania-removes-special-visa-clearance-requirement-for-nigerians/",
   "source_name": "TheCable (citing Tanzania Immigration Services notice)"
  }
 ]
